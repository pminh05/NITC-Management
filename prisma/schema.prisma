generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Tài khoản đăng nhập — 1 user map 1 thành viên (memberId), role lấy từ Member.role
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  memberId     String?  @unique
  member       Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Nhiệm kỳ (VD: 2025-2026) — roster thay đổi theo từng nhiệm kỳ
model Term {
  id       String   @id @default(cuid())
  name     String   @unique // "2025-2026"
  isActive Boolean  @default(false)
  createdAt DateTime @default(now())
  members  Member[]
  docs     Doc[]
}

// Thành viên CLB (roster) — tương ứng Member trong src/types.ts
model Member {
  id         String   @id @default(cuid()) // seed demo vẫn set id tường minh (mem-1...)
  name       String
  role       String // Chủ tịch | Phó Chủ tịch | Trưởng ban | Phó ban | Thành viên | Cố vấn
  department String // Học thuật | Truyền thông | Sự kiện | Đối ngoại | Ban Chủ nhiệm
  email      String
  phone      String?
  studentId  String? // Mã sinh viên (MSV)
  className  String? // Lớp (VD: IT67A)
  birthday   String? // dd/MM/yyyy
  status     String   @default("active") // active | inactive | alumni
  termId     String?
  term       Term?    @relation(fields: [termId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?
  tasks      Task[]   @relation("Assignee")
  ownedTasks Task[]   @relation("Creator")
  notifications    Notification[]
  notificationPref NotificationPref?
  createdDocs      Doc[]          @relation("DocCreator")
}

// Biên bản họp (NITC Archive)
model Meeting {
  id               String   @id @default(cuid())
  title            String
  department       String   @default("Ban Chủ nhiệm") // "Ban Chủ nhiệm" = họp toàn CLB; còn lại = họp riêng ban
  date             String // YYYY-MM-DD
  time             String?
  location         String?
  chairperson      String
  secretary        String
  attendees        String // JSON array string — giữ tương thích frontend
  absentees        String // JSON array string
  latecomers       String  @default("[]") // JSON array string — thành viên đi muộn (mục I.3 BBH thật)
  objectives       String  @default("") // Mục tiêu buổi họp (mục II BBH thật)
  discussionSummary String
  actionPlan       String
  rawContent       String
  createdAt        DateTime @default(now())
  tasks            Task[]
}

// Thông báo cá nhân (Trung tâm thông báo G2)
model Notification {
  id        String    @id @default(cuid())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type      String // task_assigned | deadline_tomorrow | deadline_today | overdue | evidence_submitted | evidence_approved | evidence_rejected | sticky_carried | weekly_summary | broadcast
  title     String
  body      String?
  taskId    String?
  dedupeKey String? // chống sinh trùng (type:taskId:ngày)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([dedupeKey])
  @@index([memberId, readAt])
}

// Cài đặt nhận thông báo của từng thành viên
model NotificationPref {
  memberId String  @id
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  channel  String  @default("in_app") // in_app | in_app_email | digest
  updatedAt DateTime @updatedAt
}

// Nhiệm vụ
model Task {
  id                  String    @id @default(cuid())
  title               String
  description         String?
  assigneeId          String // người phụ trách chính (người đầu tiên được chọn)
  assigneeName        String
  assigneeIds         String @default("[]") // JSON array — có thể giao nhiều người / cả ban
  department          String
  deadline            String // YYYY-MM-DD
  status              String // in_progress | pending_approval | completed | overdue
  verificationType    String // link_required | report_required
  evidenceLink        String?
  evidenceReport      String?
  evidenceSubmittedAt String?
  approvalNote        String?
  rejectedReason      String?
  sourceMeetingId     String?
  priority            String? // high | medium | normal
  isSticky            Boolean   @default(false)
  stickyWeeksCount    Int?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  assignee            Member    @relation("Assignee", fields: [assigneeId], references: [id])
  creator             Member?   @relation("Creator", fields: [createdById], references: [id])
  sourceMeeting       Meeting?  @relation(fields: [sourceMeetingId], references: [id])
}

// Nhật ký thông báo/nhắc việc (Nag Engine)
model NotificationLog {
  id            String   @id @default(cuid())
  type          String // weekly_summary | overdue_nag | task_assigned | evidence_approved | evidence_rejected
  recipientName String
  recipientEmail String
  department    String?
  subject       String
  content       String
  sentAt        DateTime @default(now())
  status        String // sent | queued | failed
  taskCount     Int?
}

// Cấu hình hệ thống (key-value) — dùng cho G5 Settings
model Setting {
  key   String @id
  value String // JSON string
}

// Kho tài liệu (G6) — link-based: phản chiếu cấu trúc Drive của CLB
model Doc {
  id          String   @id @default(cuid())
  name        String
  url         String // link Drive/Docs/Sheet/PDF...
  docType     String   @default("drive") // drive | sheet | doc | slide | pdf | image | form | other
  department  String   @default("Ban Chủ nhiệm") // "Ban Chủ nhiệm" = TÀI LIỆU CHUNG (mọi thành viên xem); còn lại = riêng ban
  termId      String?
  term        Term?    @relation(fields: [termId], references: [id])
  label       String? // nhãn tự do: Key element, Hồ sơ tài trợ, Giáo án...
  pinned      Boolean  @default(false)
  createdById String?
  createdBy   Member?  @relation("DocCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
