# GEMINI_API_KEY: bắt buộc để dùng AI parse BBH bằng Gemini.
# Lấy key miễn phí tại https://aistudio.google.com/apikey
# (Nếu bỏ trống: hệ thống tự chuyển sang parser heuristic nội bộ)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: vị trí file SQLite (Prisma). Tương đối theo thư mục prisma/
DATABASE_URL="file:./dev.db"

# JWT_SECRET: khóa bí mật ký token đăng nhập — ĐỔI trong môi trường thật!
JWT_SECRET="change-me-in-production"

# PORT: cổng server (mặc định 3000)
# PORT=3000
