# OPENAI_API_KEY: dùng cho AI đọc biên bản họp (trích xuất công việc).
# Lấy key tại https://platform.openai.com/api-keys
# (Nếu bỏ trống: hệ thống tự chuyển sang parser heuristic nội bộ)
OPENAI_API_KEY="sk-..."

# OPENAI_MODEL: model OpenAI sử dụng (mặc định gpt-4o-mini — rẻ và đủ tốt)
# OPENAI_MODEL="gpt-4o-mini"

# DATABASE_URL: vị trí file SQLite (Prisma). Tương đối theo thư mục prisma/
DATABASE_URL="file:./dev.db"

# JWT_SECRET: khóa bí mật ký phiên đăng nhập — BẮT BUỘC, tối thiểu 32 ký tự, không dùng lại giá trị mẫu.
# Sinh khóa:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Thiếu khóa: bản production (npm start) từ chối khởi động; bản dev dùng khóa tạm và mất phiên mỗi lần restart.
JWT_SECRET=""

# DEMO_MODE: true = hiện nút đăng nhập nhanh trên trang đăng nhập và KHÔNG buộc đổi mật khẩu mặc định.
# Chỉ bật khi demo/bảo vệ khóa luận. Môi trường dùng thật: để false (mặc định) —
# khi đó ai đăng nhập bằng mật khẩu mặc định sẽ phải đổi mật khẩu ngay.
DEMO_MODE=false

# ALLOW_DESTRUCTIVE_ADMIN: true = mở hai chức năng xóa sạch dữ liệu ("Reset demo", "Import toàn bộ").
# Mặc định khóa. Kể cả khi mở, server luôn tự sao lưu vào prisma/backups/ trước khi xóa.
ALLOW_DESTRUCTIVE_ADMIN=false

# PORT: cổng server (mặc định 3000)
# PORT=3000

# SCHEDULER_ENABLED: false = tắt cron (quét deadline 6h, digest 20h, báo cáo tuần)
# SCHEDULER_ENABLED=true

# Email (tùy chọn): bật gửi email thật qua SMTP
# EMAIL_ENABLED=true
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER="..."
# SMTP_PASS="..."
# SMTP_FROM="NITC Command Center <...>"
